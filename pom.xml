<?xml version="1.0" encoding="UTF-8"?>
<!--
  HAI913I — TP 2 « Compréhension et architectures » — squelette (2026-2027)

  Versions épinglées et testées : JDK 17 (minimum) et 21, Maven 3.9.6,
  JUnit Jupiter 5.14.4. AUCUNE dépendance d'exécution : le TP 2 ne relit pas
  le code source, il part des faits. JUnit est en portée « test » seulement.

  Tout est en UTF-8 : les sources, les fichiers de données, la sortie console
  et celle des tests.

    mvn clean test       compile et exécute le test de fumée (point de contrôle A0)
    mvn clean package    produit target/hai913i-tp2.jar (exécutable)
    java -jar target/hai913i-tp2.jar CHEMIN_DU_DOSSIER_DES_FAITS

  Le squelette s'arrête à l'étape A0. Le couplage (A1), le graphe pondéré (A2),
  le regroupement (B1), le dendrogramme (B2) et la coupe (B3) sont le TP.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>fr.umontpellier.hai913i</groupId>
    <artifactId>hai913i-tp2</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <!-- les trois propriétés d'encodage : sources, compilation, rapports -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.encoding>UTF-8</maven.compiler.encoding>
        <junit.version>5.14.4</junit.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>hai913i-tp2</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.14.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.4</version>
                <configuration>
                    <!-- la JVM forkée pour les tests parle aussi UTF-8 -->
                    <argLine>-Dfile.encoding=UTF-8 -Dstdout.encoding=UTF-8 -Dstderr.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>hai913i.tp2.Main</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
